# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB (local or Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/shree_krishna_rudraksh_point

# Auth (required). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# Shipping (rupees): free above FREE_SHIPPING_ABOVE, otherwise SHIPPING_CHARGE
FREE_SHIPPING_ABOVE=999
SHIPPING_CHARGE=79

# Set to false in development if you cannot receive the verification email (links are printed in the server console)
REQUIRE_VERIFIED_EMAIL=true

# Admin: products at or below this many pieces count as low stock; days a customer may request a return after delivery
LOW_STOCK_THRESHOLD=5
RETURN_WINDOW_DAYS=7


# Razorpay (Dashboard > Settings > API Keys). Use TEST keys while developing. Leave blank to hide online payment.
# The webhook secret is optional: payments are also confirmed by the browser's verify call.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (free account at cloudinary.com > Dashboard). Needed to upload product and banner photos from the admin dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Added in a later phase (leave blank for now)
# Email is optional in development: without SMTP, verification/reset links are printed in the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shree Krishna Rudraksh Point <no-reply@example.com>"
